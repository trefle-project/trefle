# Host dev (`npm --workspace @trefle/cms run dev`): copy to apps/cms/.env.local.
# Secrets: copy the values infra/dev-env.sh wrote in infra/.env, so the
# containers and the host apps agree.
DATABASE_URL=postgres://trefle:trefle@localhost:5432/trefle
PAYLOAD_SECRET=
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
# "Lien public" link on the Pages edit view -> http://<domain>:3001/<path>
PUBLIC_SITE_PROTOCOL=http
PUBLIC_SITE_PORT=3001
# The containerised Garage stand-in over its published port; the dev access
# key and secret are pinned in infra/docker-compose.override.yml
# (&garage-key / &garage-secret).
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=trefle-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# ASSET_ORIGIN stays unset on the host: Payload serves media from
# /api/media/file/* and images are not resized.
IMGPROXY_KEY=
IMGPROXY_SALT=
IMGPROXY_URL=http://localhost:8080
# Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=trefle@localhost
REVALIDATE_SECRET=
WEB_REVALIDATE_URL=http://localhost:3001/api/revalidate
UNSUBSCRIBE_SECRET=
CMS_SERVICE_API_KEY=
CONFIRM_TOKEN_SECRET=
# No authenticator code at the admin login (dev only; refused in production).
TOTP_DISABLED=1

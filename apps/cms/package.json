{
  "name": "@trefle/cms",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "predev": "npm run generate:importmap",
    "dev": "next dev --port 3000",
    "prebuild": "npm run generate:importmap",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "payload": "payload",
    "payload:migrate": "payload migrate",
    "payload:migrate:create": "payload migrate:create",
    "generate:types": "payload generate:types",
    "generate:importmap": "TOTP_DISABLED=0 payload generate:importmap",
    "seed:dev": "tsx src/seed/dev.ts",
    "totp:reset": "tsx scripts/reset-totp.ts",
    "ab:seed": "tsx scripts/seed-ab-analysis.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@aws-sdk/client-s3": "3.1157.0",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/email-nodemailer": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "@payloadcms/translations": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@trefle/grapesjs-page-import": "*",
    "@trefle/shared": "*",
    "dompurify": "3.4.8",
    "grapesjs": "0.22.16",
    "graphql": "^16.9.0",
    "next": "16.3.4",
    "payload": "3.88.0",
    "payload-totp": "3.0.6",
    "playwright-core": "1.63.0",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "sharp": "0.35.4",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "jsdom": "^30.0.1",
    "tsx": "^4.19",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^2.1"
  }
}

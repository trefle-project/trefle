{
  "name": "grapesjs-my-plugin",
  "version": "0.1.0",
  "description": "One line, mentioning GrapesJS — this is what people see in search results",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --outDir dist",
    "dev": "vite",
    "test": "vitest run"
  },
  "peerDependencies": {
    "grapesjs": "^0.21.0 || ^0.22.0 || ^0.23.0"
  },
  "devDependencies": {
    "grapesjs": "^0.23.4",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "grapesjs",
    "grapesjs-plugin",
    "page-builder",
    "visual-editor",
    "no-code"
  ],
  "license": "MIT"
}

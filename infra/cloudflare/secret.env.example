# infra/cloudflare/secret.env — production values for the infra/cloudflare
# scripts, run from an operator machine. Copy this file to secret.env (the
# name matches .gitattributes `infra/**/secret*`: git-crypt encrypted), fill
# it, commit it. Each script reads the environment first, then this file,
# then infra/.env. Keep the hostnames identical to the
# VPS's infra/.env.

# Cloudflare → the zone's Overview page.
CLOUDFLARE_ZONE_ID=
# API token for apply.sh / aop-cert.sh / purge-media.sh / add-client-domain.sh,
# scoped to this zone only: Zone Settings, Zone WAF, Cache Rules, Config Rules,
# Bot Management, SSL and Certificates, Cache Purge — all Edit.
# (Caddy's DNS-01 token is a different one, on the VPS: CLOUDFLARE_DNS_TOKEN.)
CLOUDFLARE_API_TOKEN=

# 020-edge-html-cache — the edge Worker (apps/edge). Account id: dashboard →
# Workers & Pages → right-hand column. Token for `wrangler deploy`, Worker
# routes and the exposure queue: Account → Workers Scripts Edit, Queues Edit,
# Account Analytics Read; Zone (this zone) → Workers Routes Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_TOKEN=
# Host the Worker is tried on before real hosts (EDGE_ROUTES=test). Also in
# the VPS WEB_HOSTNAMES, with a CMS domain record and a copy of /loadtest.
EDGE_TEST_HOSTNAME=edge-check.example.com

CMS_HOSTNAME=admin.example.com
IMG_HOSTNAME=img.example.com
ASSET_HOSTNAME=assets.example.com
GROWTHBOOK_HOSTNAME=experiments.example.com
GROWTHBOOK_API_HOSTNAME=experiments-api.example.com

# 019-admin-access — Cloudflare Access in front of the internal hosts
# (README « Cloudflare Access »). `trefle-config` (CLOUDFLARE_API_TOKEN) also
# needs Account → Access: Apps and Policies, Access: Service Tokens — Edit.
# 0 = apply.sh deletes the Access application (rollback); unset or 1 = applied.
ACCESS_ENABLED=
# Zero Trust team domain, e.g. https://<team>.cloudflareaccess.com
ACCESS_TEAM_DOMAIN=
# The `trefle-apply` service token: apply.sh creates it once and prints both
# values (shown only then). Paste them here.
ACCESS_SERVICE_TOKEN_ID=
ACCESS_SERVICE_TOKEN_SECRET=
# Same value as EDGE_SYNC_SECRET in the VPS infra/.env (openssl rand -hex 32).
EDGE_SYNC_SECRET=

# Cloudflare for SaaS (add-client-domain.sh).
SAAS_CNAME_TARGET=sites.example.com
ACME_DELEGATE_HOSTNAME=acme-delegate.example.com

# Hostinger VPS firewall (origin-firewall.sh). hPanel → Account → API → new
# token (VPS access). The IP identifies the VPS on the account.
HOSTINGER_API_TOKEN=
HOSTINGER_VPS_IP=203.0.113.10

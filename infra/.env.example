# Trefle — environment template. This file has NO usable secret values.
# Copy it to infra/.env (gitignored); for local dev infra/dev-env.sh does it
# and generates the secrets. Generate every production secret with:
#   openssl rand -hex 32
# `$` in a value must be written `$$` (Compose expands `${...}` in env files).
# `openssl rand -hex` output is safe (0-9a-f only) — prefer it.
# Nothing sensitive belongs in NEXT_PUBLIC_* / client-exposed vars.
#
# Local dev: infra/docker-compose.override.yml auto-points S3 + SMTP at the
# bundled Garage / Mailpit, so you can leave those blank for `docker compose up`.
# Prod: fill every blank below + the "prod only" block, then run
# infra/deploy/preflight.sh before the first `up`.

# ============ db container ============
POSTGRES_USER=trefle
# Blank -> dev compose falls back to "trefle". Prod: set a strong value;
# docker-compose.prod.yml makes it required and preflight.sh rejects "trefle".
POSTGRES_PASSWORD=
POSTGRES_DB=trefle

# ============ cms container (apps/cms — Payload) ============
# Long random string. Generate: openssl rand -hex 32
PAYLOAD_SECRET=
# Public origin of the admin (used in emails / links).
CMS_PUBLIC_URL=http://admin.trefle.localhost:3000
# Scheme + optional port for the "Lien public" link on the Pages edit view.
# The host is the page's own domain (host-routed renderer), so only these two.
#   dev  (docker compose up): http + 3001   (override sets both)
#   prod: leave blank -> https, no port
PUBLIC_SITE_PROTOCOL=
PUBLIC_SITE_PORT=
# Where the CMS posts cache-invalidation to the renderer.
WEB_REVALIDATE_URL=http://web:3001/api/revalidate
# Set JOBS_AUTORUN=true on exactly one long-running CMS process to run the
# nightly retention sweep (03:00). Leave unset in local dev.
JOBS_AUTORUN=

# ============ web container (apps/web — renderer) ============
CMS_API_URL=http://cms:3000/api
# API key of the read-only `service` user the renderer authenticates as.
# Set any hex string (openssl rand -hex 16); `seed:dev` uses this EXACT value
# for the service user, so the renderer and the DB agree with no copy-paste.
CMS_SERVICE_API_KEY=
# HMAC secrets, shared cms <-> web. Generate each: openssl rand -hex 32
REVALIDATE_SECRET=
UNSUBSCRIBE_SECRET=
CONFIRM_TOKEN_SECRET=
FORM_TOKEN_SECRET=
# Public, browser-reachable base URL of the asset bucket (consumed by BOTH
# cms and web). When set, Payload media URLs point straight at the object
# store (public, cacheable) instead of /api/media/file/*, and — with
# IMGPROXY_KEY/SALT — the renderer rewrites <img> under this origin to signed,
# sized ImgProxy URLs served from IMGPROXY_URL.
#   dev  (docker compose up): http://trefle-assets.web.garage.localhost:3902
#   prod: the public URL of the Garage bucket, e.g. https://assets.trefle.example
# Leave blank for bare `npm run dev` on the host (keeps Payload-served URLs).
ASSET_ORIGIN=
ASSET_S3_BUCKET=trefle-assets
# Core Web Vitals beacon: "1" turns the /api/vitals stub on (client-exposed flag).
NEXT_PUBLIC_VITALS_ENABLED=0

# ============ shared by cms + web ============
# Deployed build id (git sha or tag). Tags error-capture envelopes; "dev" if unset.
RELEASE=
# Optional POST endpoint for non-personal error envelopes. Unset = local log only.
ERROR_SINK_URL=

# ============ object storage (Garage — single-node stand-in locally, cluster in prod) ============
# Dev: leave blank; docker-compose.override.yml pins these at the bundled Garage
# (S3_ENDPOINT=http://garage:3900, S3_REGION=garage, GARAGE_DEFAULT_* creds).
# Prod with the self-hosted garage (option b): create the key at setup, never
# the public dev values -- S3_ACCESS_KEY_ID=GK$(openssl rand -hex 12),
# S3_SECRET_ACCESS_KEY=$(openssl rand -hex 32) (infra/deploy/README.md §1.3).
S3_ENDPOINT=
S3_REGION=garage
S3_BUCKET=trefle-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ============ ImgProxy ============
# Generate each: openssl rand -hex 32  (hex, no 0x prefix)
IMGPROXY_KEY=
IMGPROXY_SALT=
# Browser-reachable ImgProxy base URL (where rewritten <img src> point).
#   dev : http://imgproxy.localhost:8080  (container port published)
#   prod: https://<IMG_HOSTNAME>          (Caddy routes it — see prod block)
IMGPROXY_URL=http://imgproxy.localhost:8080

# ============ GrowthBook (008-ab-testing — self-hosted experimentation) ============
# Back the growthbook/growthbook-mongo containers; since 018-ab-significance the
# CMS also calls GrowthBook's API (analysis of A/B tests, block below).
# Dev: leave the *_MONGO_* and GROWTHBOOK_APP_ORIGIN/API_HOST_PUBLIC values
# blank to use docker-compose.yml's *.localhost dev fallbacks.
GROWTHBOOK_MONGO_USER=growthbook
GROWTHBOOK_MONGO_PASSWORD=
# Generate each: openssl rand -hex 32
GROWTHBOOK_JWT_SECRET=
GROWTHBOOK_ENCRYPTION_KEY=
# Browser-facing URLs for GrowthBook's OWN admin UI (its cookie-auth needs
# these to match how it's actually reached) — not the same thing as the
# internal http://growthbook:3100 address apps/cms/apps/web will use to
# reach its API server-side (a later GROWTHBOOK_API_HOST, added when the
# renderer plumbing/admin endpoints land).
GROWTHBOOK_APP_ORIGIN=
GROWTHBOOK_API_HOST_PUBLIC=
# 018-ab-significance — GrowthBook reads A/B exposures and attributed leads
# through the read-only Postgres role `growthbook_reader` (created by the CMS
# migration with this password, used by infra/growthbook/config.yml).
# Generate: openssl rand -hex 32 — set it on the VPS BEFORE the release.
GROWTHBOOK_PG_PASSWORD=
# GrowthBook secret API key (GrowthBook → Settings → API Keys), cms only.
# Empty = A/B analysis off: test screens show the counts only.
GROWTHBOOK_API_KEY=
# Internal API address (default http://growthbook:3100/api).
GROWTHBOOK_API_URL=

# ============ page import (012-url-page-import, cms only) ============
# Leave ANTHROPIC_API_KEY empty to keep "Importer depuis une page web" hidden.
ANTHROPIC_API_KEY=
# Claude model and effort used for the conversion (defaults shown).
IMPORT_AI_MODEL=claude-opus-5
IMPORT_AI_EFFORT=medium
# Test only: `fixture` returns a canned conversion (no key, no cost). The dev
# overlay sets it; the CMS refuses to boot with it when DEPLOY_ENV=production.
IMPORT_AI_MODE=
# Test only: comma-separated host names the import may load although they
# resolve to a private address (the dev overlay sets `import-fixture`).
# Refused at boot when DEPLOY_ENV=production.
IMPORT_ALLOW_PRIVATE_HOSTS=
# BROWSER_WS_URL (ws://browser:3100/) and DEPLOY_ENV (prod overlay only) are
# set by the compose files, not here.

# ============ Penpot site import (015-penpot-site-import, cms only) ============
# on = shows « Importer un site Penpot » (015). Empty = off: the button is
# hidden and the /api/site-imports/* routes answer 404. The dev overlay sets it.
PENPOT_IMPORT=

# ============ admin second factor (019-admin-access, cms only) ============
# 1 = no authenticator-app code at the admin login. Local dev and e2e only
# (the dev overlay sets it; set it in apps/cms/.env.local for `npm run dev`).
# With DEPLOY_ENV=production the CMS refuses to boot with it, and preflight.sh
# refuses the release, unless ALLOW_TOTP_DISABLED=1 is set too — the rollback
# of the 019 release only (infra/deploy/README.md).
TOTP_DISABLED=
ALLOW_TOTP_DISABLED=
# Shared with infra/cloudflare/secret.env (same value): apply.sh reads the
# member list from the CMS with it (019 step 2). openssl rand -hex 32
EDGE_SYNC_SECRET=
# Cloudflare Access (019 step 3): https://<team>.cloudflareaccess.com and the
# application's AUD tag (printed by infra/cloudflare/apply.sh --sync-members).
# Caddy verifies the Access token on CMS_HOSTNAME and the GrowthBook hosts with
# them; docker-compose.prod.yml refuses to start Caddy without them.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# ============ SMTP (Mailpit locally; real provider in prod) ============
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=trefle@localhost

# ============ prod only (infra/docker-compose.prod.yml) ============
# CMS_HOSTNAME=admin.trefle.example
# WEB_HOSTNAMES=trefle.example www.trefle.example promo.acme.com
# IMG_HOSTNAME=img.trefle.example
# ASSET_ORIGIN=https://assets.trefle.example       # public bucket URL
#   Two ways to serve it: (a) an external Garage/S3 cluster you already run
#   -- point S3_ENDPOINT above at it, leave ASSET_HOSTNAME unset; or (b) the
#   single-node `garage` service in docker-compose.prod.yml, self-hosted on
#   this VPS -- then S3_ENDPOINT=http://garage:3900, S3_REGION=garage, and:
# ASSET_HOSTNAME=assets.trefle.example              # Caddy vhost -> garage:3902 (option b only)
# GARAGE_RPC_SECRET=                                # openssl rand -hex 32 (option b only)
# IMGPROXY_URL=https://img.trefle.example           # = https://<IMG_HOSTNAME>
# SEED_ADMIN_PASSWORD=                              # >= 16 chars; `seed:dev`
#   refuses to create the first admin without it in NODE_ENV=production.
#   Change it again on first login.
# CMS_ALLOWED_ORIGINS=                              # optional, comma-separated
#   extra browser Origins allowed to call the admin (CORS/CSRF), on top of
#   CMS_PUBLIC_URL and the localhost dev hosts.
# GROWTHBOOK_HOSTNAME=experiments.trefle.example       # Caddy vhost -> growthbook:3000
# GROWTHBOOK_API_HOSTNAME=experiments-api.trefle.example  # Caddy vhost -> growthbook:3100
#   Both behind Cloudflare Access, same as CMS_HOSTNAME (019).
# GROWTHBOOK_APP_ORIGIN=https://experiments.trefle.example       # = https://<GROWTHBOOK_HOSTNAME>
# GROWTHBOOK_API_HOST_PUBLIC=https://experiments-api.trefle.example  # = https://<GROWTHBOOK_API_HOSTNAME>
# GROWTHBOOK_MONGO_PASSWORD=                        # openssl rand -hex 32
#
# 017-edge-protection — Cloudflare in front of every host (infra/cloudflare/README.md).
# Caddy obtains origin certificates by ACME DNS-01, writing the TXT record at
# ACME_DELEGATE_HOSTNAME; every served host has
# `_acme-challenge.<host> CNAME <ACME_DELEGATE_HOSTNAME>`. Unused until the
# Caddyfile's sites import `(origin_tls)`; then Caddy refuses to start without
# a valid token.
# CLOUDFLARE_DNS_TOKEN=                             # Cloudflare API token, this zone
#   only, Zone → Zone → Read + Zone → DNS → Edit, nothing else (least privilege:
#   it lives on the VPS). The scripts in infra/cloudflare use another token,
#   kept off the VPS in infra/cloudflare/secret.env.
# ACME_DELEGATE_HOSTNAME=acme-delegate.example.com
#
# 020-edge-html-cache — page HTML cached at the edge by the Worker
# (apps/edge, infra/cloudflare/README.md). All three optional: blank keeps the
# renderer in legacy mode and skips cache purges (local dev, e2e).
# EDGE_SECRET=                                      # openssl rand -hex 32; the same
#   value is the Worker's EDGE_SECRET secret (wrangler secret put). A request
#   carrying it in X-Trefle-Edge is rendered in edge mode.
# CLOUDFLARE_PURGE_TOKEN=                           # Cloudflare API token, this zone
#   only, Zone → Cache Purge → Purge, nothing else (it lives on the VPS).
# CLOUDFLARE_ZONE_ID=                               # zone id (dashboard → Overview)

# ============ e2e only (infra/docker-compose.e2e.yml) ============
# Must match @playwright/test in apps/web/package.json.
PLAYWRIGHT_IMAGE_TAG=v1.63.0-noble

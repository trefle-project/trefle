# Trefle reverse proxy. Caddy fetches + renews TLS certs automatically (ACME).
# Hostnames come from the environment (see infra/docker-compose.prod.yml):
#   CMS_HOSTNAME    one host for the Payload admin, e.g. admin.trefle.example
#   WEB_HOSTNAMES   space-separated public hosts the renderer serves
#   IMG_HOSTNAME    one host for ImgProxy, e.g. img.trefle.example
#
# The renderer host-routes internally, so every public domain can point here.

# 017-edge-protection (contracts/origin-access.md "Trusted request data") —
# behind Cloudflare the TCP peer is a Cloudflare edge. The visitor's address is
# taken from CF-Connecting-IP, and only when the peer is in Cloudflare's ranges
# (cloudflare-ips.caddy, generated by infra/cloudflare/refresh-ips.sh). While
# traffic is still direct the peer is never in those ranges, so `{client_ip}`
# is simply the peer address, as before.
{
	servers {
		import /etc/caddy/cloudflare-ips.caddy
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
	# 019-admin-access — caddy-jwt logs an INFO line on every request it
	# checks; keep only its warnings and errors (refused tokens).
	log default {
		exclude http.authentication.providers.jwt
	}
	log access_jwt {
		include http.authentication.providers.jwt
		level WARN
	}
}

# Edge security headers (002-security-hardening). HSTS is only meaningful here,
# over TLS; the apps set CSP / X-Frame-Options / Referrer-Policy themselves.
(sechdr) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

# 017-edge-protection (contracts/origin-access.md "TLS", research R3–R4) —
# origin certificates by ACME DNS-01: Caddy writes the challenge TXT at
# ACME_DELEGATE_HOSTNAME, which every served host's `_acme-challenge` CNAMEs
# to. Works behind Cloudflare (Full strict), for client `www.` hosts too, with
# port 80 closed. Switch order (research R18): sites import `origin_tls` while
# traffic is still direct; only once every host is proxied do they import
# `origin_tls_aop`, which also requires Cloudflare's Authenticated Origin Pulls
# client certificate (our own CA, infra/cloudflare/aop-cert.sh) — enabled while
# direct, it would refuse every visitor.
# `resolvers`: the propagation check asks Cloudflare's public resolvers, not
# the VPS's (Hostinger's resolver kept GoDaddy's delegation cached for hours
# after the nameserver switch and never saw the challenge TXT).
(origin_tls) {
	tls {
		dns cloudflare {env.CLOUDFLARE_DNS_TOKEN}
		dns_challenge_override_domain {$ACME_DELEGATE_HOSTNAME}
		resolvers 1.1.1.1 1.0.0.1
	}
}

(origin_tls_aop) {
	tls {
		dns cloudflare {env.CLOUDFLARE_DNS_TOKEN}
		dns_challenge_override_domain {$ACME_DELEGATE_HOSTNAME}
		resolvers 1.1.1.1 1.0.0.1
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/aop/ca.pem
		}
	}
}

# 017-edge-protection (SC-004) — access log for the image and asset hosts
# only, to count how many requests still reach the origin once Cloudflare
# caches them. No personal data: addresses and headers are dropped.
(static_access_log) {
	log {
		output stdout
		format filter {
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>headers delete
			request>tls delete
			resp_headers delete
		}
	}
}

# 020-edge-html-cache — same for the page hosts, to count how many page
# requests still reach the renderer once the edge caches them (SC-003, load
# tests). The query string is dropped too: confirm/unsubscribe links carry a
# token there.
(page_access_log) {
	log {
		output stdout
		format filter {
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>headers delete
			request>tls delete
			request>uri regexp "\?.*$" ""
			resp_headers delete
		}
	}
}

# 019-admin-access (contracts/edge-access.md "Origin verification", research
# R2) — the internal hosts answer only requests that passed Cloudflare Access:
# Access adds a signed token (Cf-Access-Jwt-Assertion) to each one it lets
# through, for a member (`email`) or the apply.sh service token
# (`common_name`). Checked against the team's published keys (re-fetched
# when a token names an unknown one, after Access rotates its key), issuer =
# the team domain, audience = the application's AUD tag; anything else gets
# 401 before the app sees it. CORS preflights pass: Access lets them through
# without a token (options_preflight_bypass) and they carry no credentials.
# ACCESS_TEAM_DOMAIN / ACCESS_AUD are required by docker-compose.prod.yml.
# Replaces the ADMIN_ALLOWED_IPS address list of 003 / 017.
(access_jwt) {
	@needsAccessToken not method OPTIONS
	route @needsAccessToken {
		jwtauth {
			from_header Cf-Access-Jwt-Assertion
			jwk_url {$ACCESS_TEAM_DOMAIN}/cdn-cgi/access/certs
			issuer_whitelist {$ACCESS_TEAM_DOMAIN}
			audience_whitelist {$ACCESS_AUD}
			user_claims email common_name
			log_level debug
		}
	}
}

{$CMS_HOSTNAME} {
	import sechdr
	import origin_tls_aop
	import access_jwt
	encode zstd gzip
	reverse_proxy cms:3000
}

{$WEB_HOSTNAMES} {
	import sechdr
	import origin_tls_aop
	import page_access_log
	encode zstd gzip
	# Next's image optimizer is unused here (images go through ImgProxy):
	# never expose it, it has been the target of remote-code-execution flaws.
	@nextImage path /_next/image /_next/image/*
	respond @nextImage 404
	reverse_proxy web:3001 {
		# Caddy sets this itself, overwriting anything the client sent —
		# unlike X-Forwarded-For (which Caddy only appends to, leaving a
		# client-spoofed first hop intact). The renderer's rate limiter trusts
		# this header, not X-Forwarded-For (003-post-launch-improvements, FR-001).
		# 017: `{client_ip}` = CF-Connecting-IP from a Cloudflare peer, else the peer.
		header_up X-Real-IP {client_ip}
	}
}

# ImgProxy answers only signed URLs, so it is safe to expose directly.
{$IMG_HOSTNAME} {
	import sechdr
	import origin_tls_aop
	import static_access_log
	encode zstd gzip
	reverse_proxy imgproxy:8080
}

# 008-ab-testing — GrowthBook's own admin UI + API, behind Cloudflare Access
# like CMS_HOSTNAME (an equally sensitive internal tool; 019). Two hostnames because
# GrowthBook's front-end (growthbook:3000) and API (growthbook:3100) must
# run on distinct origins for its own cookie-auth to work.
{$GROWTHBOOK_HOSTNAME} {
	import sechdr
	import origin_tls_aop
	import access_jwt
	encode zstd gzip
	reverse_proxy growthbook:3000
}

{$GROWTHBOOK_API_HOSTNAME} {
	import sechdr
	import origin_tls_aop
	import access_jwt
	encode zstd gzip
	reverse_proxy growthbook:3100
}

# Public bucket, only meaningful when infra/.env points S3_ENDPOINT at the
# self-hosted `garage` service (docker-compose.prod.yml "option b"). Garage's
# website endpoint vhost-routes by Host header as "<bucket>.<root_domain>"
# (see infra/garage/garage.prod.toml) -- the browser only ever sees
# ASSET_HOSTNAME, so the Host sent upstream is rewritten to match.
{$ASSET_HOSTNAME} {
	import sechdr
	import origin_tls_aop
	import static_access_log
	encode zstd gzip
	# 017-edge-protection (research R10, T031) — object keys are never reused
	# (media/fonts are stored as <base>-<hash8>.<ext>), so a file at a given
	# URL never changes: browsers and Cloudflare may keep it a year. Successful
	# responses only — a 404 must not be cached.
	header {
		Cache-Control "public, max-age=31536000, immutable"
		match {
			status 2xx
		}
	}
	reverse_proxy garage:3902 {
		header_up Host trefle-assets.web.garage.internal
	}
}
